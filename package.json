{
  "name": "@panchongshi/pi-scientist",
  "version": "1.0.0",
  "description": "Scientific analysis capabilities for pi: principles, conventions, domain skills, and convention-based tmux/Herdr subagent delegation",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.ts",
    "core",
    "dialogue",
    "tools",
    "skills",
    "docs/conventions.md",
    "docs/rule-audit.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "author": "PanChongshi",
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.9.3"
  }
}
