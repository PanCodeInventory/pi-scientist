{
  "name": "@panchongshi/pi-scientist",
  "version": "1.0.0",
  "description": "Scientific analysis capabilities for pi: principles, conventions, domain skills, and convention-based tmux/Herdr subagent delegation",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.ts",
    "core",
    "dialogue",
    "tools",
    "skills",
    "docs/conventions.md",
    "docs/rule-audit.md",
    "docs/project-skill-learning.md",
    "docs/project-skill-learning-cases.md",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:learning-ablation": "npm run build && node tests/learning-ablation.mjs",
    "test:learning-live": "npm run build && node tests/learning-live-ablation.mjs --live",
    "test:learning-topics": "npm run build && node tests/learning-live-ablation.mjs --live --topics",
    "prepack": "npm run build"
  },
  "author": "PanChongshi",
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^25.9.3",
    "typebox": "1.3.27",
    "typescript": "6.0.3"
  }
}
